{
  "name": "submission-hub",
  "private": true,
  "version": "2.1.0",
  "description": "Academic writing preparation, journal selection, submission tracking, peer-review timeline and publication archive dashboard.",
  "homepage": "https://qi-i.github.io/submission-hub/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Qi-i/submission-hub.git"
  },
  "keywords": [
    "academic",
    "submission",
    "paper-management",
    "journal-selection",
    "manuscript-preparation",
    "peer-review",
    "supabase",
    "react",
    "vite"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "check:privacy": "node scripts/check-sample-privacy.mjs",
    "check:release": "node scripts/check-release-consistency.mjs",
    "check:journal-selection": "node scripts/check-journal-selection-metadata.mjs",
    "check:journal-rank-display": "node scripts/check-journal-rank-display.mjs",
    "check:figure-studio": "node tests/figure-studio-contract.mjs",
    "check:preparation-unified": "node tests/preparation-unified-contract.mjs",
    "check:online-only": "node tests/online-only-contract.mjs",
    "verify": "npm run check:release && npm run check:privacy && npm run check:figure-studio && npm run check:preparation-unified && npm run check:online-only && node tests/journal-auto-catalog-check.mjs && npm run check:journal-selection && npm run check:journal-rank-display && node tests/visual/document-storage-check.mjs && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
